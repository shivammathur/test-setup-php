diff --git a/qa_rrd_abi.h b/qa_rrd_abi.h
new file mode 100644
index 0000000..5319c98
--- /dev/null
+++ b/qa_rrd_abi.h
@@ -0,0 +1,14 @@
+/* Match the Winlibs librrd time ABI while preserving PHP's own time_t. */
+#ifndef QA_RRD_ABI_H
+#define QA_RRD_ABI_H
+#include <time.h>
+#ifdef PHP_WIN32
+# define time_t __time64_t
+# include <rrd.h>
+# undef time_t
+typedef __time64_t qa_rrd_time_t;
+#else
+# include <rrd.h>
+typedef time_t qa_rrd_time_t;
+#endif
+#endif
