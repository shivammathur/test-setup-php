+# Remove superseded PHP entries while keeping other repositories in the same file.
+remove_old_php_sources() {
+  local file
+  for file in /etc/apt/sources.list "$list_dir"/*.list "$list_dir"/*.sources; do
+    [ -f "$file" ] || continue
+    grep -Eq "$php_repo_pattern" "$file" || continue
+    if [[ "$file" = *.sources ]]; then
+      sudo perl -00 -i -ne '
+        BEGIN { $repo = shift }
+        if (/^URIs:[ \t]*([^\n]*(?:\n[ \t]+[^\n]*)*)/mi) {
+          my ($field, $urls) = ($&, $1);
+          my @keep = grep { !m{^$repo/?$} } split " ", $urls;
+          next unless @keep;
+          s/\Q$field\E/URIs: @keep/ if $urls =~ /$repo/;
+        }
+        print;
+      ' "$php_repo_pattern" "$file" || return 1
+    else
+      sudo sed -i -E "\#^[[:space:]]*deb(-src)?[[:space:]]+(\[[^]]*\][[:space:]]+)?$php_repo_pattern/?[[:space:]]#d" "$file" || return 1
+    fi
+    if [[ "$file" = "$list_dir/"* && ! -s "$file" ]]; then
+      sudo rm -f "$file" || return 1
+    fi
+  done
+}
+
+# Recognize PHP sources in both APT formats, including the previous Ubuntu PPA.
+has_ubuntu_php_repository() {
+  apt-get indextargets --no-release-info --format '$(REPO_URI)' "Release: $VERSION_CODENAME" 'Identifier: Packages' 'Component: main' |
+    grep -Ex "($php_repo_pattern|mirror\+file:$sury_mirrors)/?" >/dev/null
+}
+
+# APT's mirror transport retries both indexes and packages in priority order.
+add_ubuntu_sury_list() (
+  local format source_file staged_dir staged_file key_file="$key_dir/debsuryorg-archive-keyring.gpg"
+  local -a curl_opts=("${curl_opts[@]}" --connect-timeout 5 --max-time 15)
+  format="$(get_sources_format)"
+  source_file="$list_dir/setup-php-ubuntu-sury-$VERSION_CODENAME.$(get_sources_extension "$format")"
+  sudo install -C -m 644 "${src:?}/configs/sury-mirrors" "$sury_mirrors" || return 1
+  [ -s "$key_file" ] || key_file="$key_dir/sury-php-keyring.gpg"
+  [ -s "$key_file" ] || add_key sury/php "$sury/php/" "$VERSION_CODENAME" "$sury/php/apt.gpg" "$key_file"
+  [ -s "$key_file" ] || return 1
+  if ! grep -Fq "mirror+file:$sury_mirrors" "$source_file" 2>/dev/null || ! grep -Fq "$key_file" "$source_file"; then
+    staged_dir="$(mktemp -d)" || return 1
+    trap 'rm -rf "$staged_dir"' EXIT
+    staged_file="$staged_dir/${source_file##*/}"
+    list_dir="$staged_dir" write_list "$format" setup-php/sury "mirror+file:$sury_mirrors" "$VERSION_CODENAME" main "$key_file" || return 1
+    update_lists_helper "$staged_file" >/dev/null || return 1
+    sudo install -m 644 "$staged_file" "$source_file" || return 1
+  else
+    update_lists sury/php "$source_file" || return 1
+  fi
+  remove_old_php_sources
+)
