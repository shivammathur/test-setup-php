--- a/src/jinclude.h
+++ b/src/jinclude.h
@@ -61,9 +61,31 @@
 
 #ifdef _MSC_VER
 
+#include <corecrt_startup.h>
+
 static INLINE int GETENV_S(char *buffer, size_t buffer_size, const char *name)
 {
   size_t required_size;
+  char **environment;
+
+  /* The CRT copies its initial environment before modifying it.  Only scan
+   * that immutable snapshot; retain the CRT getter for every mutable state.
+   * Bound the name scan to avoid repeatedly reading long environment values.
+   */
+  if (buffer && buffer_size && name && !_get_environ(&environment) &&
+      environment && environment == _get_initial_narrow_environment()) {
+    size_t length = strlen(name);
+    char **entry;
+    for (entry = environment; *entry; entry++) {
+      if (strnlen(*entry, length + 1) > length && (*entry)[length] == '=' &&
+          !_strnicoll(*entry, name, length))
+        break;
+    }
+    if (!*entry) {
+      buffer[0] = 0;
+      return 0;
+    }
+  }
 
   return (int)getenv_s(&required_size, buffer, buffer_size, name);
 }
