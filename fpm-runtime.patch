--- a/scripts/build_partials/sapi/fpm.sh
+++ b/scripts/build_partials/sapi/fpm.sh
@@ -49,6 +49,10 @@ configure_fpm() {
   cp -fp config/php-fpm.tmpfile "$INSTALL_ROOT"/usr/lib/tmpfiles.d/php"$PHP_VERSION"-fpm.conf
   cp -fp config/php-fpm.conf "$INSTALL_ROOT"/etc/apache2/conf-available/php"$PHP_VERSION"-fpm.conf
 
+  if [ "${ASAN:-}" = asan ]; then
+    cp -fp config/fpm-asan.envvars "$FPM_CONF_DIR"/asan-envvars
+  fi
+
   # Copy the scripts to INSTALL_ROOT.
   cp -fp scripts/php-fpm.init "$INSTALL_ROOT"/etc/init.d/php"$PHP_VERSION"-fpm
   cp -fp scripts/php-fpm-reopenlogs "$INSTALL_ROOT"/usr/lib/php/php"$PHP_VERSION"-fpm-reopenlogs
diff --git a/scripts/php-fpm.init b/scripts/php-fpm.init
index 323a447a9..e843a84ba 100644
--- a/scripts/php-fpm.init
+++ b/scripts/php-fpm.init
@@ -26,6 +26,13 @@ SCRIPTNAME=/etc/init.d/$NAME
 # Exit if the package is not installed
 [ -x "$DAEMON" ] || exit 0
 
+# Load the packaged sanitizer defaults before local overrides.
+if [ -r /etc/php/PHP_VERSION/fpm/asan-envvars ]; then
+	set -a
+	. /etc/php/PHP_VERSION/fpm/asan-envvars
+	set +a
+fi
+
 # Read configuration variable file if it is present
 [ -r /etc/default/$NAME ] && . /etc/default/$NAME
 
